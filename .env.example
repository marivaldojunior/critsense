# Copie este arquivo para .env e preencha os valores. O .env está no .gitignore.
# Nunca coloque chaves reais neste arquivo de exemplo.

# ─── Banco de dados ────────────────────────────────────────────────────────
DB_USER=critsense
DB_PASSWORD=critsense

# ─── Autenticação ──────────────────────────────────────────────────────────
# Chave que assina os tokens JWT (no mínimo 32 caracteres). A API não sobe
# sem ela. Para gerar uma: openssl rand -base64 48
JWT_SECRET=
# Opcional: validade de cada token (padrão: 24h).
# JWT_TTL=24h

# ─── Provedor de IA ────────────────────────────────────────────────────────
# anthropic (padrão) ou openai.
AI_PROVIDER=anthropic

# Chave do provedor escolhido. A chave fica só no backend: o app nunca fala
# direto com o provedor.
ANTHROPIC_API_KEY=
# Opcional: modelo da Anthropic (padrão: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
# Opcional: modelo da OpenAI (sem este valor, vale o padrão do Spring AI).
# SPRING_AI_OPENAI_CHAT_MODEL=

# Opcional: limites das chamadas de IA.
# AI_TIMEOUT=120s
# AI_PROVIDER_TIMEOUT=90s
# AI_RATE_LIMIT_PER_MINUTE=10
