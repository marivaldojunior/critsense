# Regras gerais do monorepo. Cada projeto tem o próprio .gitignore:
# app/.gitignore (Flutter) e api/.gitignore (Java).

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.idea/
*.iml
*.vscode

# Variáveis de ambiente locais (chaves de API, senhas)
.env
.env.*
!.env.example

# Configuração local do Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock
